{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": true,
    "allowJs": true,
    "lib": ["ESNext"],
    "strict": true,
    "module": "nodenext",
    "resolveJsonModule": true,
    "paths": {
      "#root/*": ["./*"],
      "#handlers/*": ["./handlers/*"],
      "#services/*": ["./services/*"],
      "#schemas/*": ["./schemas/*"]
    }
  },
  "exclude": ["./http-server/types/*.d.ts"]
}
